<Project Sdk="Microsoft.NET.Sdk">
  <!-- Compila a camada de host (ritmo da partida) FORA da Unity, com as mesmas restrições da Unity 6
       (netstandard2.1 + C# 9). Os arquivos-fonte ficam em Assets/; aqui só apontamos para eles. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>Fodinha.Hosting</AssemblyName>
    <RootNamespace>Fodinha.Hosting</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Assets/Fodinha/Scripts/Hosting/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../CoreBuild/Fodinha.Core.csproj" />
  </ItemGroup>
</Project>
